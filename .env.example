# --- Postgres (db service + ELT connection) ---
POSTGRES_USER=dxb
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=dxb

# ELT connection (host defaults: localhost from host runs, overridden to `db` in compose)
DXB_DB_HOST=localhost
DXB_DB_PORT=5432

# --- Collector ---
DXB_PAGE_SIZE=500
DXB_THROTTLE_SECONDS=0.4
# Concurrent in-flight page requests. The DLD gateway is undocumented and
# sits behind Cloudflare with no published rate limits, so this is a
# deliberately moderate default: per-page server latency (not our throttle)
# is the real bottleneck, so raising this is the actual speed lever, but
# too high risks the client IP getting blocked outright. Raise cautiously.
DXB_MAX_CONCURRENCY=5
DXB_SOURCE_URL=https://dubailand.gov.ae/en/open-data/real-estate-data/

# --- Scheduler (daily pipeline) ---
# DXB_SCHEDULE_HOUR/MINUTE are local container time, per TZ below.
DXB_SCHEDULE_HOUR=2
DXB_SCHEDULE_MINUTE=30
TZ=Asia/Dubai

# --- Job-level retries (tenacity around the whole daily run) ---
DXB_JOB_ATTEMPTS=3
DXB_JOB_WAIT_MIN_SECONDS=300
DXB_JOB_WAIT_MAX_SECONDS=3600

# --- SMTP alerting (leave SMTP_HOST empty to disable sending; runs are always logged to etl_run) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
ALERT_TO=serjdukareff@gmail.com
ALERT_FROM=dxb-elt@localhost

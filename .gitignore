.env
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Root-anchored on purpose: an unanchored `db/` also matched
# elt/src/dxb/db/, silently keeping the entire schema out of git.
/db/
/data/

# TLS material for the nginx edge. The dev certificate is self-signed and
# regenerable (see nginx/README.md); a private key must never be committed,
# and a real one least of all.
nginx/certs/
